# ---- Netzwerk / Server ----

APP_PORT=8000

# ---- Daten ----
# Verzeichnis für ALLE privaten Daten (DB-Dateien + Keyfile).
# Umzug der App = einfach diesen Ordner mitnehmen.

DATA_DIR=./data

# ---- Session ----
# Wie lange "30 Tage merken" gilt.

REMEMBER_DAYS=30

# Optional fester Session-Secret. Leer lassen = wird einmalig in data/ erzeugt.

SECRET_SEED=

# ---- Sicherheit ----
# Später hochstufbar: DB erst nach Passworteingabe entsperren.
# Default false = Dienst läuft ohne Eingabe durch.

REQUIRE_PASSWORD_UNLOCK=false

# ---- KI-Anbindung (lokales LLM, LAN-only) ----
# Die KI ist in der App standardmäßig AUS und liest nur, was du im KI-Fenster freigibst.
# Provider: aktuell nur "ollama". Weitere sind nachrüstbar.

AI_PROVIDER=ollama

# Interne Adresse des LLM-Servers. Am saubersten: Ollama im selben Docker-Network,
# dann http und ohne Nginx-Umweg. "ollama" = Container-/Servicename von Ollama.

AI_BASE_URL=http://ollama:11434

# Modellname, wie in Ollama installiert (z. B. llama3.2, mistral).
# Für gescannte Dokumente/Fotos braucht es ein Modell mit Bildverständnis,
# z. B. llama3.2-vision, qwen2.5vl oder gemma3 – sonst werden nur Text-Dokumente gelesen.

AI_MODEL=llama3.2

# Timeout für LLM-Anfragen in Sekunden. Die KI bekommt alle freigegebenen Daten
# vollständig; schwache lokale Modelle (z. B. auf dem Raspberry Pi) brauchen dafür lange.

AI_TIMEOUT=400
