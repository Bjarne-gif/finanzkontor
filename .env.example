# ---- Netzwerk / Server ----
APP_PORT=8000

# ---- Daten ----
# Verzeichnis für ALLE privaten Daten (DB-Dateien + Keyfile).
# Umzug der App = einfach diesen Ordner mitnehmen.
DATA_DIR=./data

# ---- Session ----
# Wie lange "30 Tage merken" gilt.
REMEMBER_DAYS=30
# Optional fester Session-Secret. Leer lassen = wird einmalig in data/ erzeugt.
SECRET_SEED=

# ---- Sicherheit ----
# Später hochstufbar: DB erst nach Passworteingabe entsperren.
# Default false = Dienst läuft ohne Eingabe durch.
REQUIRE_PASSWORD_UNLOCK=false
